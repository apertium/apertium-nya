Alphabet
 %[%+sg%]:0 %[%+pl%]:0 %[%+p1%]:0 %[%+p2%]:0 %[%+p3%]:0 %[%+pres%]:0 %[%+inf%]:0 %[%+imp%]:0 %[%+cl1%]:0 %[%+cl3%]:0 %[%+cl5%]:0 %[%+cl7%]:0 %[%+cl9%]:0 %[%+cl12%]:0 %[%+cl15%]:0 

 %[%-sg%]:0 %[%-pl%]:0 %[%-p1%]:0 %[%-p2%]:0 %[%-p3%]:0 %[%-pres%]:0 %[%-inf%]:0 %[%-imp%]:0 %[%-cl1%]:0 %[%-cl3%]:0 %[%-cl5%]:0 %[%-cl7%]:0 %[%-cl9%]:0 %[%-cl12%]:0 %[%-cl15%]:0 
;

Rules

"Match prefix"
Sx:0 /<= _ ;
   except
       _ (:*) Sy:0 ;
   where Sx in ( %[%-sg%] %[%-pl%] %[%-p1%] %[%-p2%] %[%-p3%] %[%-pres%] %[%-inf%] %[%-imp%] %[%-cl1%] %[%-cl3%] %[%-cl5%] %[%-cl7%] %[%-cl9%] %[%-cl12%] %[%-cl15%] )
         Sy in ( %[%+sg%] %[%+pl%] %[%+p1%] %[%+p2%] %[%+p3%] %[%+pres%] %[%+inf%] %[%+imp%] %[%+cl1%] %[%+cl3%] %[%+cl5%] %[%+cl7%] %[%+cl9%] %[%+cl12%] %[%+cl15%] )
   matched ;

"Inverse of Match prefix for use with mismatched tags"
Sx:0 /<= _ ;
   except
       Sy:0 :* _ ;
   where Sy in ( %[%-sg%] %[%-pl%] %[%-p1%] %[%-p2%] %[%-p3%] %[%-pres%] %[%-inf%] %[%-imp%] %[%-cl1%] %[%-cl3%] %[%-cl5%] %[%-cl7%] %[%-cl9%] %[%-cl12%] %[%-cl15%] )
         Sx in ( %[%+sg%] %[%+pl%] %[%+p1%] %[%+p2%] %[%+p3%] %[%+pres%] %[%+inf%] %[%+imp%] %[%+cl1%] %[%+cl3%] %[%+cl5%] %[%+cl7%] %[%+cl9%] %[%+cl12%] %[%+cl15%] )
matched ;



!Sets
!
!Features = %[%+sg%] %[%+pl%] %[%+abs%] %[%+def%] %[%+inst%] %[%+p1%] %[%+p2%] %[%+p3%] %[%+aa%] %[%+nn%];
!
!Rules
!
!"Match prefixes with agreement tags"
!Fx:0 <=> _ :* Fx:0 ;
!         Fx:0 :* _ ;
!     where Fx in Features ;
