! Morphological Transducer for Nyanja

Multichar_Symbols

! Part of speech categories
%<n%>       ! Noun
%<adj%>     ! Adjective
%<prn%>     ! Pronoun
%<vblex%>   ! Verb
%<pr%>      ! preposition
%<cnjcoo%>  ! coordinating conjunction
%<cnjsub%>  ! subordinating conjunction

! Number morphology
%<pl%>      ! Plural
%<sg%>      ! Singular

! Person morphology
%<p1%>      ! First person
%<p2%>      ! Second person
%<p3%>      ! Third person

! Noun-class morphology (and Adj and Pron)
%<cl1%>     ! Class 1 noun
%<cl1a%>    ! Class 1a noun (See Meeuwis, 2010)
%<cl3%>     ! Class 3 noun
%<cl5%>     ! Class 5 noun
%<cl7%>     ! Class 7 noun
%<cl8%>     ! Class 8 noun
%<cl9%>     ! Class 9 noun
%<cl9a%>    ! Class 9-6 noun
%<cl12%>    ! Class 12 noun (derived, from nouns)
%<cl14%>    ! Class 14 noun
%<cl15%>    ! Class 15 noun (derived, from verbs)
%<cl16%>    ! Class 16 noun (derived, from nouns)
%<cl17%>    ! Class 17 noun (derived, from nouns)
%<cl18%>    ! Class 18 noun (derived, from nouns)

! Pronoun morpholgy
%<pers%>   ! Personal pronoun
%<nom%>   ! Nominal class pronoun

! Verb tense and mood morphology
%<pres%>    ! Present continuous tense
%<imp%>     ! Imperative
%<inf%>     ! Infinitive

! Other symbols
%>      ! Morpheme boundary
%{A%}   ! used for some Class V-VI nouns plural prefix, wina, ina, etc
%{U%}   ! dropped for some Class I-II nouns plural prefix
%{B%}   ! used for some Class V-VI nouns
%{D%}   ! used for some Class V-VI nouns
%{H%}	! dropped after aspirant in the plural!
%{L%}
%{I%}   ! used for some Class V-VI nouns
! %{M%}	! dropped after m
%{T%}   ! used for some Class V-VI nouns
%{Z%}   ! used for some Class V-VI nouns
%{W%}   ! becomes y in the plural for c3-4 nouns

! Path features
%[%-sg%]
%[%+sg%]
%[%-pl%]
%[%+pl%]

%[%+p1%]   ! First person
%[%+p2%]   ! Second person
%[%+p3%]   ! Third person
%[%+inf%]  ! Infinitive
%[%+imp%]  ! Imperative

%[%-p1%]   ! First person
%[%-p2%]   ! Second person
%[%-p3%]   ! Third person
%[%-inf%]  ! Infinitive
%[%-imp%]  ! Imperative

