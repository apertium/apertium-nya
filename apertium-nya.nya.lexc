LEXICON Root
NounPrefix ;
DerivedNounPrefix ;
NounRoot ;
Adjective-Prefix ;
Pronouns ;
PrepsConjs ;
VerbPersonNum-Prefix ;

LEXICON RegNounInfl
%<n%>%<sg%>: # ;
%<n%>%<pl%>:%>s # ;

LEXICON COMMON-Suffix
# ;

