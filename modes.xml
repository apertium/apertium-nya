<?xml version="1.0" encoding="UTF-8"?>
<modes>

  <mode name="nya-twol" install="no">
    <pipeline>
      <program name="hfst-strings2fst -S"/>
      <program name="hfst-compose-intersect">
        <file name=".deps/nya.twol.hfst"/>
      </program>
      <program name="hfst-fst2strings"/>
    </pipeline>
  </mode>

  <mode name="nya-morph" install="yes">
    <pipeline>
      <program name="lt-proc -w">
        <file name="nya.automorf.bin"/>
      </program>
    </pipeline>
  </mode>


  <mode name="nya-lexc" install="no">
    <pipeline>
      <program name="hfst-lookup">
        <file name=".deps/nya.LR.lexc.hfst"/>
      </program>
    </pipeline>
  </mode>

  <mode name="nya-gener" install="yes">
    <pipeline>
      <program name="lt-proc -g">
        <file name="nya.autogen.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="nya-tagger" install="yes">
    <pipeline>
      <program name="lt-proc -w">
        <file name="nya.automorf.bin"/>
      </program>
      <program name="cg-proc -w">
        <file name="nya.rlx.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="nya-disam" install="yes">
    <pipeline>
      <program name="lt-proc -w">
        <file name="nya.automorf.bin"/>
      </program>
      <program name="cg-conv -a"/>
      <program name="vislcg3 --trace --grammar">
        <file name="nya.rlx.bin"/>
      </program>
    </pipeline>
  </mode>

  <mode name="nya-paradigm" install="yes">
    <pipeline>
      <program name="lt-paradigm -s">
        <file name="nya.autogen.bin"/>
      </program>
    </pipeline>
  </mode>

</modes>

